#
# BACKENDLAYOUT: EXAMPLE
#
mod {
    web_layout {
        BackendLayouts {
            default_template {
                title = DEFAULT TEMPLATE - SITEPACKAGE
                config {
                    backend_layout {
                        colCount = 1
                        rowCount = 1
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = HERO IMAGE
                                        colPos = 1
                                    }
                                }
                            }
                            2 {
                                columns {
                                    1 {
                                        // name = LLL:EXT:echoes_package/Resources/Private/Language/locallang_be.xlf:backend_layout.column.normal
                                        name = MAIN CONTENT
                                        colPos = 0
                                    }
                                }
                            }
                        }
                    }
                }
                icon = EXT:echoes_package/Resources/Public/Icons/BackendLayouts/example.svg
            }
        }
    }
}
