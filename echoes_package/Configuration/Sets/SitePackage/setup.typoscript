page {
    includeCSS {
        theme = EXT:echoes_package/Resources/Public/Scss/Theme/theme.scss
    }

    includeJSLibs {

    }

    includeJS {

    }

    includeJSFooterlibs {

    }

    includeJSFooter {
        echoes_package_scripts = EXT:echoes_package/Resources/Public/JavaScript/main.js
    }
}
page = PAGE
page {
    10 = FLUIDTEMPLATE
    10 {
        file = EXT:echoes_package/Resources/Private/Templates/Page/Default.html
        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references.fieldName = background_image
                as = backgroundImages
            }
        }
    }
}

