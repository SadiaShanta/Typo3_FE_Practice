page.10.dataProcessing {
    100 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
    100 {
        includeSpacer = 1
        special = list
        special.value = 40,41,42,43
        as = mainnavigation
    }
    2000 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
    2000 {
        special = directory
        special.value = 54
        as = footernavigation
    }

}