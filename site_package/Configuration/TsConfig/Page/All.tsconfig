mod.wizards.newContentElement.wizardItems.special {
  elements.heroSlider {
    iconIdentifier = content-image
    title = LLL:EXT:site_package/Resources/Private/Language/locallang_db.xlf:heroSlider.title
    description = LLL:EXT:site_package/Resources/Private/Language/locallang_db.xlf:heroSlider.description
    tt_content_defValues {
      CType = heroSlider
    }
  }
  show := addToList(heroSlider)
}
